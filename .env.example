# Upstash Redis (invite storage)
# Create a free DB at https://console.upstash.com → Redis → REST API
# Free tier is enough for early invites (watch command/day + storage limits).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL for Open Graph / absolute links (optional locally)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
